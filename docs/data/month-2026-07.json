cd77e5d645620a83a1c3","count_precision":"exact-displayed-integer","capture_precision":"collection-run-start","selection_policy":"latest-known-snapshot; minimum on same-time conflict"},"text_status":"captured_displayed_source_text","text_source":"https://nitter.jaydenha.uk/nayibbukele/with_replies?cursor=DAAHCgABHVwYT51__poLAAIAAAATMjA4MTU3NDAxMDI4Mjc3ODgwMAgAAwAAAAIAAA","text_truncated":false},{"id":"x-2078699573623554450","post_id":"2078699573623554450","platform":"x","author":"nayibbukele","original_url":"https://x.com/nayibbukele/status/2078699573623554450","published_at":"2026-07-19T04:32:53.379Z","published_date":"2026-07-19","date_precision":"millisecond","source_ids":["nitter-public-timeline"],"text":"Solo un tonto pensaría que atacaríamos a un pueblo hermano por una piedra donde no vive nadie y que no produce nada.\n\nIgual, la droga no la dejaremos pasar. Si la incautamos a miles de kilómetros, también la incautaremos en el Golfo de Fonseca.\n\nPero ese tema es con los narcos.\n\nEntre pueblos: hermandad.","post_kind":"quote","is_repost":false,"author_verified":true,"like_count":13487,"likes_captured_at":"2026-10-28T23:51:54.990547+00:00","likes_source":{"provider":"nitter-public-timeline","url":"https://nitter.jaydenha.uk/nayibbukele/with_replies?cursor=DAAHCgABHVwYT51__poLAAIAAAATMjA4MTU3NDAxMDI4Mjc3ODgwMAgAAwAAAAIAAA","sha256":"67179c0aaca4ec1adc6cb060c260810e4ecf4dbdfd16cd77e5d645620a83a1c3","count_precision":"exact-displayed-integer","capture_precision":"collection-run-start","selection_policy":"latest-known-snapshot; minimum on same-time conflict"},"text_status":"captured_displayed_source_text","text_source":"https://nitter.jaydenha.uk/nayibbukele/with_replies?cursor=DAAHCgABHVwYT51__poLAAIAAAATMjA4MTU3NDAxMDI4Mjc3ODgwMAgAAwAAAAIAAA","text_truncated":false},{"id":"x-2078546630899282045","post_id":"2078546630899282045","platform":"x","author":"nayibbukele","original_url":"https://x.com/nayibbukele/status/2078546630899282045","published_at":"2026-07-18T18:25:08.992Z","published_date":"2026-07-18","date_precision":"millisecond","source_ids":["nitter-public-timeline"],"text":"Hace apenas un mes asestamos el golpe más contundente al narcotráfico en la historia de El Salvador. Hoy, nuestra Marina Nacional vuelve a golpear a las organizaciones del crimen transnacional.\n\nEl 17 de julio, nuestra Marina Nacional interceptó una LMFB (Lancha con Motor Fuera de Borda) a 947 millas náuticas (1,764 km) al suroeste de la Bocana El Cordoncillo, en el Estero de Jaltepeque.\n\nA bordo viajaban dos narcotraficantes de nacionalidad ecuatoriana, quienes transportaban 1.36 toneladas de cocaína, valoradas en aproximadamente $34 millones de dólares.\n\nCon esta nueva incautación, El Salvador acumula 14.61 toneladas de cocaína decomisadas en lo que va del año, valoradas en más de $365.25 millones de dólares.\n\nSeguiremos golpeando al narcotráfico donde antes operaba con total impunidad.","post_kind":"original","is_repost":false,"author_verified":true,"like_count":17694,"likes_captured_at":"2026-10-28T23:51:54.990547+00:00","likes_source":{"provider":"nitter-public-timeline","url":"https://nitter.jaydenha.uk/nayibbukele/with_replies?cursor=DAAHCgABHVwYT51__poLAAIAAAATMjA4MTU3NDAxMDI4Mjc3ODgwMAgAAwAAAAIAAA","sha256":"67179c0aaca4ec1adc6cb060c260810e4ecf4dbdfd16cd77e5d645620a83a1c3","count_precision":"exact-displayed-integer","capture_precision":"collection-run-start","selection_policy":"latest-known-snapshot; minimum on same-time conflict"},"text_status":"captured_displayed_source_text","text_source":"https://nitter.jaydenha.uk/nayibbukele/with_replies?cursor=DAAHCgABHVwYT51__poLAAIAAAATMjA4MTU3NDAxMDI4Mjc3ODgwMAgAAwAAAAIAAA","text_truncated":false},{"id":"x-2078220255906709833","post_id":"2078220255906709833","platform":"x","author":"nayibbukele","original_url":"https://x.com/nayibbukele/status/2078220255906709833","published_at":"2026-07-17T20:48:15.130Z","published_date":"2026-07-17","date_precision":"millisecond","source_ids":["nitter-public-timeline"],"text":"On our way to becoming the safest country in the world.","post_kind":"quote","is_repost":false,"author_verified":true,"like_count":14779,"likes_captured_at":"2026-10-28T23:51:54.990547+00:00","likes_source":{"provider":"nitter-public-timeline","url":"https://nitter.jaydenha.uk/nayibbukele/with_replies?cursor=DAAHCgABHVwYT51__poLAAIAAAATMjA4MTU3NDAxMDI4Mjc3ODgwMAgAAwAAAAIAAA","sha256":"67179c0aaca4ec1adc6cb060c260810e4ecf4dbdfd16cd77e5d645620a83a1c3","count_precision":"exact-displayed-integer","capture_precision":"collection-run-start","selection_policy":"latest-known-snapshot; minimum on same-time conflict"},"text_status":"captured_displayed_source_text","text_source":"https://nitter.jaydenha.uk/nayibbukele/with_replies?cursor=DAAHCgABHVwYT51__poLAAIAAAATMjA4MTU3NDAxMDI4Mjc3ODgwMAgAAwAAAAIAAA","text_truncated":false},{"id":"x-2077094370105311687","post_id":"2077094370105311687","platform":"x","author":"nayibbukele","original_url":"https://x.com/nayibbukele/status/2077094370105311687","published_at":"2026-07-14T18:14:23.037Z","published_date":"2026-07-14","date_precision":"millisecond","source_ids":["nitter-public-timeline"],"text":"Muchos argumentan que la mayoría de los países que permiten la reelección indefinida de su jefe de Gobierno son “democracias parlamentarias”, y resulta interesante que presenten ese sistema como superior.\n\nEl simple hecho de agregarle la palabra “democracia” como adjetivo no lo convierte automáticamente en un sistema más democrático. De hecho, una de sus principales características es que el pueblo no elige directamente a su jefe de Gobierno; llámese Primer Ministro, como en el Reino Unido; Presidente, como en España; o Canciller, como en Alemania. Es el partido político, o la coalición de partidos, quien lo designa.\n\nEse mismo partido puede removerlo y sustituirlo por otra persona, incluso por alguien que la población apenas conozca o por quien jamás haya votado directamente.\n\nEse sistem…","post_kind":"quote","is_repost":false,"author_verified":true,"like_count":15990,"likes_captured_at":"2026-10-28T23:51:54.990547+00:00","likes_source":{"provider":"nitter-public-timeline","url":"https://nitter.jaydenha.uk/nayibbukele/with_replies?cursor=DAAHCgABHVwYT51__poLAAIAAAATMjA4MTU3NDAxMDI4Mjc3ODgwMAgAAwAAAAIAAA","sha256":"67179c0aaca4ec1adc6cb060c260810e4ecf4dbdfd16cd77e5d645620a83a1c3","count_precision":"exact-displayed-integer","capture_precision":"collection-run-start","selection_policy":"latest-known-snapshot; minimum on same-time conflict"},"text_status":"captured_displayed_source_text","text_source":"https://nitter.jaydenha.uk/nayibbukele/with_replies?cursor=DAAHCgABHVwYT51__poLAAIAAAATMjA4MTU3NDAxMDI4Mjc3ODgwMAgAAwAAAAIAAA","text_truncated":true},{"id":"x-2077028277756018964","post_id":"2077028277756018964","platform":"x","author":"nayibbukele","original_url":"https://x.com/nayibbukele/status/2077028277756018964","published_at":"2026-07-14T13:51:45.393Z","published_date":"2026-07-14","date_precision":"millisecond","source_ids":["nitter-public-timeline"],"text":"También la tienen Canadá, Reino Unido, Alemania, Australia, Nueva Zelanda, Irlanda, Italia, los Países Bajos, Bélgica, Suecia, Noruega, Dinamarca, Finlandia, Islandia, Luxemburgo, Austria, Suiza, y Japón, entre muchos otros países.\n\nPero la idea es que suene mal 😂","post_kind":"quote","is_repost":false,"author_verified":true,"like_count":51743,"likes_captured_at":"2026-10-28T23:51:54.990547+00:00","likes_source":{"provider":"nitter-public-timeline","url":"https://nitter.jaydenha.uk/nayibbukele/with_replies?cursor=DAAHCgABHVwYT51__poLAAIAAAATMjA4MTU3NDAxMDI4Mjc3ODgwMAgAAwAAAAIAAA","sha256":"67179c0aaca4ec1adc6cb060c260810e4ecf4dbdfd16cd77e5d645620a83a1c3","count_precision":"exact-displayed-integer","capture_precision":"collection-run-start","selection_policy":"latest-known-snapshot; minimum on same-time conflict"},"text_status":"captured_displayed_source_text","text_source":"https://nitter.jaydenha.uk/nayibbukele/with_replies?cursor=DAAHCgABHVwYT51__poLAAIAAAATMjA4MTU3NDAxMDI4Mjc3ODgwMAgAAwAAAAIAAA","text_truncated":false},{"id":"x-2076040435995218145","post_id":"2076040435995218145","platform":"x","author":"nayibbukele","original_url":"https://x.com/nayibbukele/status/2076040435995218145","published_at":"2026-07-11T20:26:25.564Z","published_date":"2026-07-11","date_precision":"millisecond","source_ids":["nitter-public-timeline"],"text":"Hemos establecido un hospital de campaña en Venezuela para brindar atención médica de primer nivel. Además, contamos con un servicio de veterinaria para atender a los peluditos.\n\nEstaremos abiertos las 24 horas para la atención de personas y de 8am a 6pm para la atención de mascotas.\n\nNos encontramos ubicados en la Avenida Principal de Playa Grande, atrás del Colegio Carlos Escarra, frente al restaurante Rompeolas, en La Guaira.\n\nFuerza Venezuela 🇸🇻🇻🇪","post_kind":"original","is_repost":false,"author_verified":true,"like_count":60414,"likes_captured_at":"2026-10-28T23:51:54.990547+00:00","likes_source":{"provider":"nitter-public-timeline","url":"https://nitter.jaydenha.uk/nayibbukele/with_replies?cursor=DAAHCgABHVwYT51__poLAAIAAAATMjA4MTU3NDAxMDI4Mjc3ODgwMAgAAwAAAAIAAA","sha256":"67179c0aaca4ec1adc6cb060c260810e4ecf4dbdfd16cd77e5d645620a83a1c3","count_precision":"exact-displayed-integer","capture_precision":"collection-run-start","selection_policy":"latest-known-snapshot; minimum on same-time conflict"},"text_status":"captured_displayed_source_text","text_source":"https://nitter.jaydenha.uk/nayibbukele/with_replies?cursor=DAAHCgABHVwYT51__poLAAIAAAATMjA4MTU3NDAxMDI4Mjc3ODgwMAgAAwAAAAIAAA","text_truncated":false},{"id":"x-2075395800042004715","post_id":"2075395800042004715","platform":"x","author":"nayibbukele","original_url":"https://x.com/nayibbukele/status/2075395800042004715","published_at":"2026-07-10T01:44:52.376Z","published_date":"2026-07-10","date_precision":"millisecond","source_ids":["nitter-public-timeline"],"text":"🇸🇻","post_kind":"quote","is_repost":false,"author_verified":true,"like_count":6123,"likes_captured_at":"2026-10-28T23:51:54.990547+00:00","likes_source":{"provider":"nitter-public-timeline","url":"https://nitter.jaydenha.uk/nayibbukele/with_replies?cursor=DAAHCgABHVwYT51__poLAAIAAAATMjA4MTU3NDAxMDI4Mjc3ODgwMAgAAwAAAAIAAA","sha256":"67179c0aaca4ec1adc6cb060c260810e4ecf4dbdfd16cd77e5d645620a83a1c3","count_precision":"exact-displayed-integer","capture_precision":"collection-run-start","selection_policy":"latest-known-snapshot; minimum on same-time conflict"},"text_status":"captured_displayed_source_text","text_source":"https://nitter.jaydenha.uk/nayibbukele/with_replies?cursor=DAAHCgABHVwYT51__poLAAIAAAATMjA4MTU3NDAxMDI4Mjc3ODgwMAgAAwAAAAIAAA","text_truncated":false},{"id":"x-2075042060298555471","post_id":"2075042060298555471","platform":"x","author":"nayibbukele","original_url":"https://x.com/nayibbukele/status/2075042060298555471","published_at":"2026-07-09T02:19:14.249Z","published_date":"2026-07-09","date_precision":"millisecond","source_ids":["nitter-public-timeline"],"text":"#NewProfilePic","post_kind":"original","is_repost":false,"author_verified":true,"like_count":17726,"likes_captured_at":"2026-10-28T23:51:54.990547+00:00","likes_source":{"provider":"nitter-public-timeline","url":"https://nitter.jaydenha.uk/nayibbukele/with_replies?cursor=DAAHCgABHVwYT51__poLAAIAAAATMjA4MTU3NDAxMDI4Mjc3ODgwMAgAAwAAAAIAAA","sha256":"67179c0aaca4ec1adc6cb060c260810e4ecf4dbdfd16cd77e5d645620a83a1c3","count_precision":"exact-displayed-integer","capture_precision":"collection-run-start","selection_policy":"latest-known-snapshot; minimum on same-time conflict"},"text_status":"captured_displayed_source_text","text_source":"https://nitter.jaydenha.uk/nayibbukele/with_replies?cursor=DAAHCgABHVwYT51__poLAAIAAAATMjA4MTU3NDAxMDI4Mjc3ODgwMAgAAwAAAAIAAA","text_truncated":false},{"id":"x-2073781031635677242","post_id":"2073781031635677242","platform":"x","author":"nayibbukele","original_url":"https://x.com/nayibbukele/status/2073781031635677242","published_at":"2026-07-05T14:48:21.587Z","published_date":"2026-07-05","date_precision":"millisecond","source_ids":["nitter-public-timeline"],"text":"Muchos de los miembros de nuestra misión ya se encuentran exhaustos. Por ello, hemos decidido enviar un séptimo avión con 120 especialistas para relevar a quienes más lo necesitan. Los otros 180 integrantes del contingente original continuarán en el terreno, por lo que mantendremos en todo momento un equipo de 300 rescatistas, médicos, paramédicos, psicólogos, veterinarios, bomberos y otros especialistas, muchos de ellos preparados específicamente para esta nueva fase de la misión.\n\nAdemás, aprovechamos este vuelo para enviar cinco toneladas adicionales de ayuda humanitaria, con medicamentos, alimentos, insumos y equipo para reforzar las labores que continúan en la zona.\n\nNuestros equipos de rescate siguen trabajando al 100%. Muchos de los nuevos integrantes se incorporarán directamente a…","post_kind":"original","is_repost":false,"author_verified":true,"like_count":73711,"likes_captured_at":"2026-10-28T23:51:54.990547+00:00","likes_source":{"provider":"nitter-public-timeline","url":"https://nitter.jaydenha.uk/nayibbukele/with_replies?cursor=DAAHCgABHVwYT51__oYLAAIAAAATMjA3NTA0MjA2MDI5ODU1NTQ3MQgAAwAAAAIAAA","sha256":"870a94e8b768068640a2bb45056b37ad22524acdd60e2b75e9b1ad21d3b33030","count_precision":"exact-displayed-integer","capture_precision":"collection-run-start","selection_policy":"latest-known-snapshot; minimum on same-time conflict"},"text_status":"captured_displayed_source_text","text_source":"https://nitter.jaydenha.uk/nayibbukele/with_replies?cursor=DAAHCgABHVwYT51__oYLAAIAAAATMjA3NTA0MjA2MDI5ODU1NTQ3MQgAAwAAAAIAAA","text_truncated":true},{"id":"x-2073573330985066763","post_id":"2073573330985066763","platform":"x","author":"nayibbukele","original_url":"https://x.com/nayibbukele/status/2073573330985066763","published_at":"2026-07-05T01:03:01.893Z","published_date":"2026-07-05","date_precision":"millisecond","source_ids":["nitter-public-timeline"],"text":"Muchos han visto las labores de búsqueda y rescate. Sin embargo, esta tragedia también ha dejado a miles de niños enfrentando pérdidas irreparables.\n\nAlgunos perdieron a su mamá o a su papá; otros, a ambos. Muchos perdieron sus hogares y todo lo que tenían.\n\nPor eso, además de las labores de rescate, estamos realizando jornadas especialmente pensadas para ellos. A través de juegos, actividades recreativas y espacios seguros, nuestros equipos brindan atención psicológica y apoyo emocional, velando por su salud mental y su bienestar.\n\nEn los próximos días continuaremos visitando las comunidades afectadas para llevar atención médica, atención psicológica, programas de primera infancia y actividades para los niños. Acompañarlos en estos momentos de trauma también es urgente.\n\n🇸🇻🇻🇪","post_kind":"original","is_repost":false,"author_verified":true,"like_count":37299,"likes_captured_at":"2026-10-28T23:51:54.990547+00:00","likes_source":{"provider":"nitter-public-timeline","url":"https://nitter.jaydenha.uk/nayibbukele/with_replies?cursor=DAAHCgABHVwYT51__oYLAAIAAAATMjA3NTA0MjA2MDI5ODU1NTQ3MQgAAwAAAAIAAA","sha256":"870a94e8b768068640a2bb45056b37ad22524acdd60e2b75e9b1ad21d3b33030","count_precision":"exact-displayed-integer","capture_precision":"collection-run-start","selection_policy":"latest-known-snapshot; minimum on same-time conflict"},"text_status":"captured_displayed_source_text","text_source":"https://nitter.jaydenha.uk/nayibbukele/with_replies?cursor=DAAHCgABHVwYT51__oYLAAIAAAATMjA3NTA0MjA2MDI5ODU1NTQ3MQgAAwAAAAIAAA","text_truncated":false},{"id":"x-2073482198271824134","post_id":"2073482198271824134","platform":"x","author":"nayibbukele","original_url":"https://x.com/nayibbukele/status/2073482198271824134","published_at":"2026-07-04T19:00:54.161Z","published_date":"2026-07-04","date_precision":"millisecond","source_ids":["nitter-public-timeline"],"text":"Happy 250th birthday to all my friends in the USA! 🇺🇸","post_kind":"original","is_repost":false,"author_verified":true,"like_count":93399,"likes_captured_at":"2026-10-28T23:51:54.990547+00:00","likes_source":{"provider":"nitter-public-timeline","url":"https://nitter.jaydenha.uk/nayibbukele/with_replies?cursor=DAAHCgABHVwYT51__oYLAAIAAAATMjA3NTA0MjA2MDI5ODU1NTQ3MQgAAwAAAAIAAA","sha256":"870a94e8b768068640a2bb45056b37ad22524acdd60e2b75e9b1ad21d3b33030","count_precision":"exact-displayed-integer","capture_precision":"collection-run-start","selection_policy":"latest-known-snapshot; minimum on same-time conflict"},"text_status":"captured_displayed_source_text","text_source":"https://nitter.jaydenha.uk/nayibbukele/with_replies?cursor=DAAHCgABHVwYT51__oYLAAIAAAATMjA3NTA0MjA2MDI5ODU1NTQ3MQgAAwAAAAIAAA","text_truncated":false},{"id":"x-2072855631791296712","post_id":"2072855631791296712","platform":"x","author":"nayibbukele","original_url":"https://x.com/nayibbukele/status/2072855631791296712","published_at":"2026-07-03T01:31:09.071Z","published_date":"2026-07-03","date_precision":"millisecond","source_ids":["nitter-public-timeline"],"text":"Durante estos días les he compartido principalmente las labores de búsqueda y rescate, porque cada vida salvada representa una enorme esperanza.\n\nPero nuestra misión en Venezuela va mucho más allá. Nuestros equipos también trabajan sin descanso llevando ayuda humanitaria a quienes más lo necesitan, con alimentos, agua potable, medicamentos, insumos médicos y todo lo necesario para fortalecer la respuesta a esta emergencia.\n\nAl mismo tiempo, médicos y personal especializado brindan atención directa en hospitales y comunidades, así como atención veterinaria para los animales afectados.\n\nFuerza Venezuela 🇸🇻🇻🇪","post_kind":"original","is_repost":false,"author_verified":true,"like_count":42040,"likes_captured_at":"2026-10-28T23:51:54.990547+00:00","likes_source":{"provider":"nitter-public-timeline","url":"https://nitter.jaydenha.uk/nayibbukele/with_replies?cursor=DAAHCgABHVwYT51__oYLAAIAAAATMjA3NTA0MjA2MDI5ODU1NTQ3MQgAAwAAAAIAAA","sha256":"870a94e8b768068640a2bb45056b37ad22524acdd60e2b75e9b1ad21d3b33030","count_precision":"exact-displayed-integer","capture_precision":"collection-run-start","selection_policy":"latest-known-snapshot; minimum on same-time conflict"},"text_status":"captured_displayed_source_text","text_source":"https://nitter.jaydenha.uk/nayibbukele/with_replies?cursor=DAAHCgABHVwYT51__oYLAAIAAAATMjA3NTA0MjA2MDI5ODU1NTQ3MQgAAwAAAAIAAA","text_truncated":false},{"id":"x-2072681282815844616","post_id":"2072681282815844616","platform":"x","author":"nayibbukele","original_url":"https://x.com/nayibbukele/status/2072681282815844616","published_at":"2026-07-02T13:58:21.036Z","published_date":"2026-07-02","date_precision":"millisecond","source_ids":["nitter-public-timeline"],"text":"¡FINALMENTE LOGRAMOS RESCATAR A HERNÁN!\n\nDespués de más de 72 horas de trabajo y tras enfrentar una estructura sumamente inestable, réplicas, derrumbes y la necesidad de abrir una nueva vía de acceso para poder llegar hasta él, rescatamos con vida a Hernán Alberto Gil Flores, de 44 años, quien permaneció más de 7 días atrapado bajo los escombros del centro comercial Galerías Playa Grande.\n\nEste rescate fue posible gracias al esfuerzo conjunto de los equipos de Chile, Estados Unidos, Portugal, México, Costa Rica, Venezuela y El Salvador, que trabajaron sin descanso para remover escombros, estabilizar la estructura y abrir paso hasta llegar a Hernán.\n\nNuestra admiración y reconocimiento para todos los rescatistas que participaron en esta operación, así como para Hernán, cuya fortaleza y res…","post_kind":"original","is_repost":false,"author_verified":true,"like_count":67389,"likes_captured_at":"2026-10-28T23:51:54.990547+00:00","likes_source":{"provider":"nitter-public-timeline","url":"https://nitter.jaydenha.uk/nayibbukele/with_replies?cursor=DAAHCgABHVwYT51__oYLAAIAAAATMjA3NTA0MjA2MDI5ODU1NTQ3MQgAAwAAAAIAAA","sha256":"870a94e8b768068640a2bb45056b37ad22524acdd60e2b75e9b1ad21d3b33030","count_precision":"exact-displayed-integer","capture_precision":"collection-run-start","selection_policy":"latest-known-snapshot; minimum on same-time conflict"},"text_status":"captured_displayed_source_text","text_source":"https://nitter.jaydenha.uk/nayibbukele/with_replies?cursor=DAAHCgABHVwYT51__oYLAAIAAAATMjA3NTA0MjA2MDI5ODU1NTQ3MQgAAwAAAAIAAA","text_truncated":true},{"id":"x-2072468585927119115","post_id":"2072468585927119115","platform":"x","author":"nayibbukele","original_url":"https://x.com/nayibbukele/status/2072468585927119115","published_at":"2026-07-01T23:53:10.146Z","published_date":"2026-07-01","date_precision":"millisecond","source_ids":["nitter-public-timeline"],"text":"En el último avance que publiqué sobre el rescate de Hernán, llevábamos 28 horas de trabajo. Ahora ya son 58 horas y aún no hemos logrado sacarlo.\n\nLa dificultad es que Hernán se encuentra atrapado dentro de una estructura de nueve pisos sumamente inestable, y el túnel que habíamos excavado ha sufrido varios derrumbes.\n\nEquipos de rescate de varios países han estado trabajando juntos sin descanso para estabilizar el túnel, apuntalándolo, reforzándolo y aislándolo, pero no ha sido posible sostenerlo.\n\nPor lo que se ha tomado la decisión de abrir, de forma paralela, un nuevo túnel desde otro punto, donde podría haber una mayor posibilidad de avanzar con seguridad. Sin embargo, toda la estructura sigue corriendo el riesgo de colapsar, y no descartamos retomar el túnel original en el que nues…","post_kind":"quote","is_repost":false,"author_verified":true,"like_count":41501,"likes_captured_at":"2026-10-28T23:51:54.990547+00:00","likes_source":{"provider":"nitter-public-timeline","url":"https://nitter.jaydenha.uk/nayibbukele/with_replies?cursor=DAAHCgABHVwYT51__oYLAAIAAAATMjA3NTA0MjA2MDI5ODU1NTQ3MQgAAwAAAAIAAA","sha256":"870a94e8b768068640a2bb45056b37ad22524acdd60e2b75e9b1ad21d3b33030","count_precision":"exact-displayed-integer","capture_precision":"collection-run-start","selection_policy":"latest-known-snapshot; minimum on same-time conflict"},"text_status":"captured_displayed_source_text","text_source":"https://nitter.jaydenha.uk/nayibbukele/with_replies?cursor=DAAHCgABHVwYT51__oYLAAIAAAATMjA3NTA0MjA2MDI5ODU1NTQ3MQgAAwAAAAIAAA","text_truncated":true}]