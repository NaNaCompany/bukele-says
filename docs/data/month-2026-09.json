iginal","is_repost":false,"author_verified":true,"like_count":11076,"likes_captured_at":"2026-10-28T23:51:54.990547+00:00","likes_source":{"provider":"nitter-public-timeline","url":"https://nitter.jaydenha.uk/nayibbukele/with_replies?cursor=DAAHCgABHVwYT51__00LAAIAAAATMjEwMzYyNDM4MDg1NzM4OTMyMQgAAwAAAAIAAA","sha256":"63c24a2c229d96dfd45ab714d30a492a5db91338a2fbb510133a96e7e09b5d5d","count_precision":"exact-displayed-integer","capture_precision":"collection-run-start","selection_policy":"latest-known-snapshot; minimum on same-time conflict"},"text_status":"captured_displayed_source_text","text_source":"https://nitter.jaydenha.uk/nayibbukele/with_replies?cursor=DAAHCgABHVwYT51__00LAAIAAAATMjEwMzYyNDM4MDg1NzM4OTMyMQgAAwAAAAIAAA","text_truncated":false},{"id":"x-2102910059789361565","post_id":"2102910059789361565","platform":"x","author":"nayibbukele","original_url":"https://x.com/nayibbukele/status/2102910059789361565","published_at":"2026-09-23T23:56:43.090Z","published_date":"2026-09-23","date_precision":"millisecond","source_ids":["nitter-public-timeline"],"text":"Hemos trasladado los restos de Francisco Morazán a un nuevo mausoleo, construido especialmente para custodiarlos por siempre.\n\nEl mausoleo se encuentra a un costado del Palacio Nacional, dentro del nuevo Jardín Centroamérica.\n\nEstará abierto al público a partir de mañana, jueves 24 de septiembre, a las 7pm.\n\nLa entrada será gratuita.","post_kind":"original","is_repost":false,"author_verified":true,"like_count":23301,"likes_captured_at":"2026-10-28T23:51:54.990547+00:00","likes_source":{"provider":"nitter-public-timeline","url":"https://nitter.jaydenha.uk/nayibbukele/with_replies?cursor=DAAHCgABHVwYT51__00LAAIAAAATMjEwMzYyNDM4MDg1NzM4OTMyMQgAAwAAAAIAAA","sha256":"63c24a2c229d96dfd45ab714d30a492a5db91338a2fbb510133a96e7e09b5d5d","count_precision":"exact-displayed-integer","capture_precision":"collection-run-start","selection_policy":"latest-known-snapshot; minimum on same-time conflict"},"text_status":